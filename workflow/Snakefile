    CLUSTER_ALL_TARGETS = _targets(
        CLUSTER_PREPROCESS_TARGETS,
        CORE_ANALYSIS_TARGETS,
        STRUCTURE_TARGETS,
        PHYLOGENY_TARGETS,
        SFS_TARGETS,
