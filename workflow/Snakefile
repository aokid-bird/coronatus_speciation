configfile: "config/config.yaml"

PROJECT_CFG = config.get("project", {}) or {}
ENVIRONMENT = config.get("environment") or PROJECT_CFG.get("environment") or "cluster"
IS_LOCAL = ENVIRONMENT == "local"
IS_CLUSTER = ENVIRONMENT == "cluster"

include: "rules/common_config.smk"
include: "rules/common_paths.smk"
include: "rules/common_samples.smk"
include: "rules/common_analysis.smk"
include: "rules/common_rules.smk"
include: "rules/reference_shared.smk"
include: "rules/outgroup_shared.smk"
include: "rules/transfer.smk"


def _targets(*items):
    flattened = []
    for item in items:
        if not item:
            continue
        if isinstance(item, (list, tuple)):
            flattened.extend(item)
        else:
            flattened.append(item)
    return flattened

if IS_LOCAL:
    include: "rules/reference_local.smk"
    include: "rules/outgroup_local.smk"
else:
    include: "rules/qc_trimmomatic.smk"
    include: "rules/qc_trimmomatic_ingroup.smk"
    include: "rules/mapping_outgroup.smk"
    include: "rules/mapping_ingroup.smk"
    include: "rules/slice_outgroups.smk"
    include: "rules/angsd_intersect.smk"
    include: "rules/angsd_global.smk"
    if SFS_ENABLED:
        include: "rules/angsd_sfs.smk"
    if PCANGSD_ENABLED:
        include: "rules/pcangsd.smk"
    if NGSADMIX_ENABLED:
        include: "rules/ngsadmix.smk"
    if RAXML_ENABLED:
        include: "rules/angsd_raxml.smk"
    if TREEMIX_ENABLED:
        include: "rules/angsd_treemix.smk"
    if NGSDIST_ENABLED:
        include: "rules/ngsdist.smk"
    if ABBABABA2_ENABLED:
        include: "rules/angsd_abbababa2.smk"
    if SNAPP_ENABLED:
        include: "rules/snapp.smk"

PCANGSD_TARGETS = globals().get("PCANGSD_TARGETS", [])
NGSADMIX_TARGETS = globals().get("NGSADMIX_TARGETS", [])
NGSDIST_TARGETS = globals().get("NGSDIST_TARGETS", [])
