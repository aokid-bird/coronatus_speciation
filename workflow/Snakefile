            f"{SNAPP_ALIGN_DIR}/snapp.min{SNAPP_MIN_SAMPLES_LOCUS}.bin.nexus",
        ]
        for _run in SNAPP_RUN_IDS:
            SNAPP_TARGETS.append(f"{SNAPP_BASE}/constraints/{_run}.txt")
