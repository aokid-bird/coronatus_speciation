    SFS_TARGETS = _targets(
        expand(
            f"results/angsd_sfs/{output_prefix}/{{site_filter}}/{{group}}/gl.geno.gz",
            site_filter=SFS_SITE_FILTERS_ACTIVE,
            group=groups,
