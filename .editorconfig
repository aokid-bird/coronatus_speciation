# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = space
indent_size = 4

[*.py]
max_line_length = 88

[*.R]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[Snakefile]
indent_style = space
indent_size = 4
